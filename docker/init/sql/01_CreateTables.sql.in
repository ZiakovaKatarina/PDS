CREATE TABLE "ZASTAVKA" (
  "zastavka_id" number(10) PRIMARY KEY NOT NULL,
  "nazov" varchar2(200) NOT NULL,
  "obec" varchar2(200),
  "psc" varchar2(5),
  "bezbarierovy_pristup" number(1)
);

CREATE TABLE "LINKA" (
  "linka_id" number(10) PRIMARY KEY NOT NULL,
  "cislo" varchar2(30),
  "nazov" varchar2(200) NOT NULL,
  "smer" varchar2(100) NOT NULL
);

CREATE TABLE "VOZIDLO" (
  "vin_cislo_vozidla" varchar(17) PRIMARY KEY NOT NULL,
  "typ_vozidla" nvarchar2(255) NOT NULL CHECK ("typ_vozidla" IN ('MINIBUS', 'STANDARDNY', 'KLBOVY', 'DVOJPODLAZNY')) NOT NULL,
  "spz" varchar2(7) UNIQUE NOT NULL,
  "kapacita" number(3) NOT NULL,
  "aktivne" number(1) NOT NULL,
  "stav_vozidla" t_stav_vozidla NOT NULL,
  "pristupnost_invalidom" number(1)
);

CREATE TABLE "VODIC" (
  "osobne_cislo" varchar2(30) PRIMARY KEY NOT NULL,
  "meno" varchar2(80) NOT NULL,
  "priezvisko" varchar2(80) NOT NULL,
  "email" varchar2(254),
  "telefon" varchar2(30),
  "aktivny" number(1) NOT NULL
);

CREATE TABLE "JAZDA" (
  "jazda_id" number(10) PRIMARY KEY NOT NULL,
  "vin_cislo_vozidla" varchar(17) NOT NULL,
  "linka_id" number(10) NOT NULL,
  "osobne_cislo_vodica" varchar(30) NOT NULL,
  "stav" nvarchar2(255) NOT NULL CHECK ("stav" IN ('PLANOVANA', 'PREBIEHA', 'DOKONCENA', 'ZRUSENA')) NOT NULL,
  "planovany_odchod" timestamp NOT NULL
);

CREATE TABLE "PREJAZD_ZASTAVKOU" (
  "jazda_id" number(10) NOT NULL,
  "poradie_na_jazde" number(8) NOT NULL,
  "zastavka_id" number(10) NOT NULL,
  "vzdialenost_od_zaciatku_km" number(10,3),
  "planovany_prichod" timestamp,
  "planovany_odchod" timestamp,
  "skutocny_prichod" timestamp,
  "skutocny_odchod" timestamp,
  PRIMARY KEY ("jazda_id", "poradie_na_jazde")
);

CREATE TABLE "TARIFA" (
  "tarifa_id" number(10) PRIMARY KEY NOT NULL,
  "typ_tarify" nvarchar2(255) NOT NULL CHECK ("typ_tarify" IN ('PLNE', 'DETSKA', 'STUDENTSKA', 'SENIORSKA', 'INE_ZLAVNENE')) NOT NULL,
  "platnost_od" date NOT NULL,
  "platnost_do" date NOT NULL,
  "vzdialenost_od_km" number(10,3) NOT NULL,
  "vzdialenost_do_km" number(10,3) NOT NULL,
  "cena_eur" number(10,2) NOT NULL
);

CREATE TABLE "LISTOK" (
  "cislo_listka" varchar2(40) PRIMARY KEY NOT NULL,
  "poradie_nastupnej_zastavky" number(8) NOT NULL,
  "poradie_vystupnej_zastavky" number(8) NOT NULL,
  "jazda_id" number(10) NOT NULL,
  "tarifa_id" number(10) NOT NULL,
  "predane_at" timestamp NOT NULL,
  "uctovana_cena_eur" number(10,2) NOT NULL,
  "stav" nvarchar2(255) NOT NULL CHECK ("stav" IN ('PLATNY', 'STORNOVANY')) NOT NULL,
  "stornovane_at" timestamp
);

CREATE TABLE "UDALOST" (
  "udalost_id" number(10) PRIMARY KEY NOT NULL,
  "vin_cislo_vozidla" varchar(17) NOT NULL,
  "osobne_cislo_vodica" varchar2(30),
  "typ" nvarchar2(255) NOT NULL CHECK ("typ" IN ('ZAVADA', 'PORUCHA', 'INCIDENT')) NOT NULL,
  "vznik_at" timestamp NOT NULL,
  "nahlasene_at" timestamp NOT NULL,
  "nazov" varchar2(150) NOT NULL,
  "popis" clob NOT NULL,
  "zavaznost" nvarchar2(255) NOT NULL CHECK ("zavaznost" IN ('NIZKA', 'STREDNA', 'VYSOKA', 'KRITICKA')) NOT NULL,
  "blokuje_prevadzku" number(1) NOT NULL,
  "stav" nvarchar2(255) NOT NULL CHECK ("stav" IN ('NAHLASENA', 'V_RIESENI', 'UZAVRETA')) NOT NULL,
  "uzavrete_at" timestamp
);

CREATE TABLE "SERVISNY_ZASAH" (
  "zasah_id" number(10) PRIMARY KEY NOT NULL,
  "vin_cislo_vozidla" varchar(17) NOT NULL,
  "udalost_id" number(10),
  "typ" nvarchar2(255) NOT NULL CHECK ("typ" IN ('OPRAVA', 'PRAVIDELNA_KONTROLA', 'STK', 'EK', 'UDRZBA')) NOT NULL,
  "planovany_zaciatok" timestamp NOT NULL,
  "planovany_koniec" timestamp NOT NULL,
  "skutocny_zaciatok" timestamp,
  "skutocny_koniec" timestamp,
  "stav" nvarchar2(255) NOT NULL CHECK ("stav" IN ('PLANOVANY', 'PREBIEHA', 'DOKONCENY', 'ZRUSENY')) NOT NULL,
  "servis" varchar2(150),
  "popis_prac" clob,
  "naklady_eur" number(12,2)
);

CREATE TABLE "DOKUMENT_VODICA" (
  "dokument_id" number(10) PRIMARY KEY NOT NULL,
  "osobne_cislo_vodica" varchar2(30) NOT NULL,
  "typ_dokumentu" nvarchar2(255) NOT NULL CHECK ("typ_dokumentu" IN ('VODICSKY_PREUKAZ', 'PSYCHOTEST', 'ZDRAVOTNE_POTVRDENIE', 'KVALIFIKACNY_PREUKAZ', 'POTVRDENIE_SKOLENIA', 'INE')) NOT NULL,
  "datum_vydania" date NOT NULL,
  "platnost_do" date,
  "vysledok" nvarchar2(255) NOT NULL CHECK ("vysledok" IN ('VYHOVEL', 'NEVYHOVEL')),
  "nazov_suboru" varchar2(255) NOT NULL,
  "typ_suboru" nvarchar2(255) NOT NULL CHECK ("typ_suboru" IN ('pdf', 'jpg', 'png', 'txt')) NOT NULL,
  "obsah" blob NOT NULL,
  "nahrane_at" timestamp NOT NULL,
  "popis" clob
);

CREATE INDEX "ix_zastavka_nazov" ON "ZASTAVKA" ("nazov");

CREATE UNIQUE INDEX "uq_linka_cislo_smer" ON "LINKA" ("cislo", "smer");

CREATE INDEX "ix_jazda_vin" ON "JAZDA" ("vin_cislo_vozidla");

CREATE INDEX "ix_jazda_vodic" ON "JAZDA" ("osobne_cislo_vodica");

CREATE INDEX "ix_prejazd_zastavka" ON "PREJAZD_ZASTAVKOU" ("zastavka_id");

CREATE INDEX "ix_tarifa_typ_platnost" ON "TARIFA" ("typ_tarify", "platnost_od");

CREATE INDEX "ix_listok_jazda_stav" ON "LISTOK" ("jazda_id", "stav");

CREATE INDEX "ix_listok_predane_at" ON "LISTOK" ("predane_at");

CREATE INDEX "ix_listok_tarifa" ON "LISTOK" ("tarifa_id");

CREATE INDEX "ix_listok_nastup" ON "LISTOK" ("jazda_id", "poradie_nastupnej_zastavky");

CREATE INDEX "ix_listok_vystup" ON "LISTOK" ("jazda_id", "poradie_vystupnej_zastavky");

CREATE INDEX "ix_udalost_vozidlo_cas" ON "UDALOST" ("vin_cislo_vozidla", "vznik_at");

CREATE INDEX "ix_udalost_vodic_cas" ON "UDALOST" ("osobne_cislo_vodica", "vznik_at");

CREATE INDEX "ix_udalost_stav_cas" ON "UDALOST" ("stav", "vznik_at");

CREATE INDEX "ix_servis_vozidlo_cas" ON "SERVISNY_ZASAH" ("vin_cislo_vozidla", "planovany_zaciatok");

CREATE INDEX "ix_servis_udalost" ON "SERVISNY_ZASAH" ("udalost_id");

CREATE INDEX "ix_servis_stav_cas" ON "SERVISNY_ZASAH" ("stav", "planovany_zaciatok");

CREATE INDEX "ix_dokument_vodic_platnost" ON "DOKUMENT_VODICA" ("osobne_cislo_vodica", "typ_dokumentu", "platnost_do");

COMMENT ON TABLE "ZASTAVKA" IS 'Základné údaje o zastávke. Zdroj a externé ID sú voliteľné, napríklad pri importe zo stops.txt.';

COMMENT ON TABLE "LINKA" IS 'Jeden záznam predstavuje jeden smer/variant linky. Opačný smer evidujte ako samostatnú položku.';

COMMENT ON TABLE "VOZIDLO" IS 'T_STAV_VOZIDLA má konštruktor, členské funkcie km_do_kontroly(),
dni_do_stk(p_k_datu DATE) a MAP priorita_kontroly().
Kapacita musí byť väčšia ako nula. Aktivne 0/1 označuje evidenčné zaradenie.
';

COMMENT ON COLUMN "VOZIDLO"."stav_vozidla" IS 'Oracle objekt: najazdene_km, kontrola_pri_km, stk_platna_do.';

COMMENT ON TABLE "JAZDA" IS 'Konkrétna jazda linky v konkrétnom čase; nejde o kompletný cestovný poriadok.
Vozidlo a vodič môžu byť pri plánovaní nezadaní.
';

COMMENT ON TABLE "PREJAZD_ZASTAVKOU" IS 'Jedna zastávka na konkrétnej jazde.
Poradie je v rámci jazdy jedinečné a vzdialenosť od začiatku nesmie klesať.
Vzdialenosť je povinná, keď sa cena lístka počíta podľa kilometrov.
';

COMMENT ON TABLE "TARIFA" IS 'Vlastná zjednodušená tarifa v EUR.
Vzdialenostné pásmo je [od, do), platnosť je vrátane oboch dátumov.
PL/SQL kontroluje platnosť intervalu a zakáže prekrytie taríf rovnakého typu.
';

COMMENT ON TABLE "LISTOK" IS 'Lístok sa vzťahuje na konkrétnu jazdu a úsek linky.
PL/SQL overí, že obe zastávky patria na linku jazdy, nástup je pred výstupom
a cena zodpovedá tarife. Uctovana_cena_eur uchová skutočnú cenu predaja.
Predaj kontroluje kapacitu vozidla na jednotlivých úsekoch.
';

COMMENT ON TABLE "UDALOST" IS 'Udalosť môže vzniknúť aj mimo jazdy. PL/SQL kontroluje čas uzavretia podľa stavu.';

COMMENT ON COLUMN "UDALOST"."osobne_cislo_vodica" IS 'je null, pretoze mozu byt udalosti ked vodic nie je pritomny, napriklad vandalstvo v noci';

COMMENT ON TABLE "SERVISNY_ZASAH" IS 'Jeden servisný zásah môže súvisieť najviac s jednou udalosťou.
Udalost_id je NULL pri plánovanej údržbe bez konkrétnej udalosti.
PL/SQL kontroluje časové intervaly, vozidlo a kolízie s jazdami.
';

COMMENT ON COLUMN "SERVISNY_ZASAH"."servis" IS 'nazov servisu/dielne/opravovne kde sa vykonal servis, nechame NULL lebo si to mozu vykonat aj sami v depe';

COMMENT ON TABLE "DOKUMENT_VODICA" IS 'Súbor a jeho evidenčné údaje patria konkrétnemu vodičovi.
Typ, platnosť a pri psychoteste aj výsledok umožnia vytvoriť
report o dokladoch a upozorniť na blížiaci sa koniec platnosti.
';

ALTER TABLE "DOKUMENT_VODICA" ADD FOREIGN KEY ("osobne_cislo_vodica") REFERENCES "VODIC" ("osobne_cislo") DEFERRABLE INITIALLY IMMEDIATE;

ALTER TABLE "PREJAZD_ZASTAVKOU" ADD FOREIGN KEY ("zastavka_id") REFERENCES "ZASTAVKA" ("zastavka_id") DEFERRABLE INITIALLY IMMEDIATE;

ALTER TABLE "PREJAZD_ZASTAVKOU" ADD FOREIGN KEY ("jazda_id") REFERENCES "JAZDA" ("jazda_id") DEFERRABLE INITIALLY IMMEDIATE;

ALTER TABLE "JAZDA" ADD FOREIGN KEY ("linka_id") REFERENCES "LINKA" ("linka_id") DEFERRABLE INITIALLY IMMEDIATE;

ALTER TABLE "JAZDA" ADD FOREIGN KEY ("vin_cislo_vozidla") REFERENCES "VOZIDLO" ("vin_cislo_vozidla") DEFERRABLE INITIALLY IMMEDIATE;

ALTER TABLE "JAZDA" ADD FOREIGN KEY ("osobne_cislo_vodica") REFERENCES "VODIC" ("osobne_cislo") DEFERRABLE INITIALLY IMMEDIATE;

ALTER TABLE "LISTOK" ADD FOREIGN KEY ("jazda_id") REFERENCES "JAZDA" ("jazda_id") DEFERRABLE INITIALLY IMMEDIATE;

ALTER TABLE "LISTOK" ADD FOREIGN KEY ("tarifa_id") REFERENCES "TARIFA" ("tarifa_id") DEFERRABLE INITIALLY IMMEDIATE;

ALTER TABLE "LISTOK" ADD FOREIGN KEY ("jazda_id", "poradie_nastupnej_zastavky") REFERENCES "PREJAZD_ZASTAVKOU" ("jazda_id", "poradie_na_jazde") DEFERRABLE INITIALLY IMMEDIATE;

ALTER TABLE "LISTOK" ADD FOREIGN KEY ("jazda_id", "poradie_vystupnej_zastavky") REFERENCES "PREJAZD_ZASTAVKOU" ("jazda_id", "poradie_na_jazde") DEFERRABLE INITIALLY IMMEDIATE;

ALTER TABLE "UDALOST" ADD FOREIGN KEY ("vin_cislo_vozidla") REFERENCES "VOZIDLO" ("vin_cislo_vozidla") DEFERRABLE INITIALLY IMMEDIATE;

ALTER TABLE "UDALOST" ADD FOREIGN KEY ("osobne_cislo_vodica") REFERENCES "VODIC" ("osobne_cislo") DEFERRABLE INITIALLY IMMEDIATE;

ALTER TABLE "SERVISNY_ZASAH" ADD FOREIGN KEY ("vin_cislo_vozidla") REFERENCES "VOZIDLO" ("vin_cislo_vozidla") DEFERRABLE INITIALLY IMMEDIATE;

ALTER TABLE "SERVISNY_ZASAH" ADD FOREIGN KEY ("udalost_id") REFERENCES "UDALOST" ("udalost_id") DEFERRABLE INITIALLY IMMEDIATE;
